{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/consulting", "destination": "/services", "permanent": true },
    { "source": "/blog", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
